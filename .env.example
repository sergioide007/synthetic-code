# Copia este fichero a .env y rellena las claves que vayas a usar, o
# expórtalas directamente en tu shell. Nunca commitees el fichero .env real.

# --- Proveedores de LLM (al menos uno para las demos "reales") ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LOCALLLM_BASE_URL=http://localhost:8000/v1

# --- Redis (opcional; sólo para demos/tests de TokenBudget distribuido) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Backend de trazas de la API (opcional) ---
# Por defecto se usa SQLite local (SINTETICO_API_DB_PATH). Para un
# despliegue con más de una instancia del servicio, apunta aquí a
# Postgres (requiere `pip install -e ".[postgres]"`); el live-tail
# funcionará entre instancias vía LISTEN/NOTIFY:
# SINTETICO_API_DB_URL=postgresql://user:pass@host:5432/sintetico
SINTETICO_API_DB_PATH=sintetico_traces.db

# --- Autenticación de la API (opcional) ---
# Si se deja vacía, la API no exige autenticación (modo demo local).
# Si se configura, todos los endpoints /api/v1/* (salvo /health) exigen
# la cabecera `X-API-Key: <valor>`.
SINTETICO_API_KEY=

# --- Overrides de catálogo de modelos (opcional) ---
# Usa esto si Anthropic publica un nuevo id de modelo y quieres apuntar
# las demos a él sin tocar código:
# SINTETICO_MODEL_HAIKU=claude-haiku-4-5-20251001
# SINTETICO_MODEL_SONNET=claude-sonnet-5
# SINTETICO_MODEL_OPUS=claude-opus-4-8

# Copy this file to .env and fill in the keys you are going to use, or export
# them in your shell. Never commit the real .env file.

# --- LLM providers (at least one, only for the demos that call a real API) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LOCALLLM_BASE_URL=http://localhost:8000/v1

# --- Audit log key (HMAC chain). Use a long random value and keep it out of the repository ---
SINTETICO_AUDIT_KEY=

# --- Redis (optional; only for the distributed TokenBudget demos/tests) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Trace backend of the API (optional) ---
# Local SQLite is used by default (SINTETICO_API_DB_PATH). For a deployment
# with more than one instance of the service, point this to Postgres
# (needs `pip install -e ".[postgres]"`); the live tail then works across
# instances through LISTEN/NOTIFY:
# SINTETICO_API_DB_URL=postgresql://user:pass@host:5432/sintetico
SINTETICO_API_DB_PATH=sintetico_traces.db

# --- Integration tests (optional; for CI) ---
# If set, the PostgresTraceStore and RedisBudgetBackend tests run against
# real instances. If not, they are skipped cleanly.
# SINTETICO_TEST_POSTGRES_URL=postgresql://user:pass@localhost:5432/sintetico_test
# SINTETICO_TEST_REDIS_URL=redis://localhost:6379/0
# SINTETICO_TEST_KAFKA=localhost:9092

# --- API authentication (optional) ---
# If left empty, the API requires no authentication (local demo mode).
# If set, every /api/v1/* endpoint (except /health) requires the header
# `X-API-Key: <value>`.
SINTETICO_API_KEY=

# --- Model catalog overrides (optional) ---
# Use these when a provider publishes a new model id and you want to point
# the examples to it without touching code:
# SINTETICO_MODEL_HAIKU=<model id>
# SINTETICO_MODEL_SONNET=<model id>
# SINTETICO_MODEL_OPUS=<model id>
